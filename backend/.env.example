NODE_ENV=development
PORT=3101

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cleango

FRONTEND_ORIGIN=http://127.0.0.1:3100
JWT_SECRET=change_this_secret
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Routing gratis untuk demo. Self-host OSRM sebelum penggunaan produksi.
OSRM_BASE_URL=https://router.project-osrm.org

# Layanan inference Python AI-01 dan AI-02
AI_SERVICE_URL=http://127.0.0.1:5000
AI_SERVICE_TOKEN=change_this_internal_token

# AI-04: urutan model chatbot Groq; satu key untuk ketiganya.
# Qwen masih preview; periksa ketersediaannya sebelum deployment.
# Dicoba berurutan saat timeout/error provider, lalu fallback FAQ/admin.
GROQ_API_KEY=
# Tetap false sampai integrasi akun, katalog, promo, dan pesanan chatbot siap diuji.
CHATBOT_DATABASE_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
