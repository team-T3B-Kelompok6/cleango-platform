NODE_ENV=development
PORT=3101

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cleango

FRONTEND_ORIGIN=http://127.0.0.1:3100
JWT_SECRET=change_this_secret
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Routing gratis untuk demo. Self-host OSRM sebelum penggunaan produksi.
OSRM_BASE_URL=https://router.project-osrm.org

# CS AI Boo: urutan model Groq; satu key untuk ketiganya. Tidak perlu server Python.
# Qwen masih preview; periksa ketersediaannya sebelum deployment.
# Dicoba berurutan saat timeout/error provider, lalu fallback FAQ/admin.
GROQ_API_KEY=
# Aktifkan agar Boo dapat membaca pesanan milik pelanggan yang sedang masuk.
# Isolasi data sudah diuji: pesanan akun lain tidak pernah dikembalikan.
CHATBOT_DATABASE_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
