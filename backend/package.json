{
  "name": "cleango-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest --configLoader runner --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "26.6.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
