NODE_ENV=development
PORT=3000

# Safe public configuration (may be used by frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Prefer the new secret key. The service-role key remains a
# legacy fallback for older projects. Never expose either to mobile/web clients.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
AI_PROVIDER=rule_based
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
