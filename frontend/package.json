{
  "name": "cleango-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:demo": "node scripts/check-admin-demo.mjs",
    "check:category-icons": "node scripts/check-category-icons.mjs",
    "check:service-image": "node scripts/check-service-image.mjs",
    "check:staff-skills": "node scripts/check-staff-skills.mjs",
    "check:staff-metrics": "node scripts/check-staff-metrics.mjs",
    "check:categories": "node scripts/check-categories.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:promo": "node scripts/check-promo-pricing.mjs",
    "qa:api": "node scripts/uts-qa-api.mjs",
    "check:uts:http": "node scripts/check-uts-http.mjs",
    "format": "prettier --write app components features hooks lib store types scripts next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check app components features hooks lib store types scripts next.config.ts package.json tsconfig.json",
    "check:reports": "node scripts/check-reports.mjs",
    "check:pagination": "node scripts/check-pagination.mjs"
