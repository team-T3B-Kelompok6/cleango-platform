{
  "name": "cleango-frontend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:demo": "node scripts/check-admin-demo.mjs",
    "check:promo": "node scripts/check-promo-pricing.mjs",
    "qa:api": "node scripts/uts-qa-api.mjs",
    "check:uts:http": "node scripts/check-uts-http.mjs",
    "format": "prettier --write app components lib types next.config.ts package.json tsconfig.json",
    "format:check": "prettier --check app components lib types next.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3"
  }
}
