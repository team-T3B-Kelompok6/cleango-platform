diff --git a/backend/tests/service-categories.test.ts b/backend/tests/service-categories.test.ts
new file mode 100644
index 0000000..9113ef4
--- /dev/null
+++ b/backend/tests/service-categories.test.ts
@@ -0,0 +1,209 @@
+import jwt from 'jsonwebtoken';
+import request from 'supertest';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const database = vi.hoisted(() => ({
+  query: vi.fn(),
+  execute: vi.fn(),
+  getConnection: vi.fn(),
+}));
+vi.mock('../src/lib/db.js', () => ({ pool: database }));
+
+import { createApp } from '../src/app.js';
+
+const app = createApp();
+const token = (role = 'admin') =>
+  jwt.sign(
+    { id: 1, email: 'test@example.com', role },
+    process.env.JWT_SECRET ?? 'cleango-development-only',
+  );
+const connection = {
+  query: vi.fn(),
+  execute: vi.fn(),
+  beginTransaction: vi.fn(),
+  commit: vi.fn(),
+  rollback: vi.fn(),
+  release: vi.fn(),
+};
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  database.getConnection.mockResolvedValue(connection);
+  connection.execute.mockResolvedValue([{ affectedRows: 1 }]);
+});
+
+describe('service category deletion', () => {
+  it('requires an admin session for deletion', async () => {
+    expect((await request(app).delete('/api/admin/categories/9')).status).toBe(
+      401,
+    );
+    expect(
+      (
+        await request(app)
+          .delete('/api/admin/categories/9')
+          .set('Authorization', `Bearer ${token('customer')}`)
+      ).status,
+    ).toBe(403);
+    expect(database.execute).not.toHaveBeenCalled();
+  });
+
+  it('deletes an unused category by its numeric database id', async () => {
+    database.execute.mockResolvedValue([{ affectedRows: 1 }]);
+    const response = await request(app)
+      .delete('/api/admin/categories/9')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(200);
+    expect(database.execute).toHaveBeenCalledWith(
+      'DELETE FROM service_categories WHERE id = ?',
+      [9],
+    );
+  });
+
+  it('reports an already deleted category', async () => {
+    database.execute.mockResolvedValue([{ affectedRows: 0 }]);
+    const response = await request(app)
+      .delete('/api/admin/categories/9')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(404);
+  });
+
+  it('rejects deletion when a service starts using the category before the delete', async () => {
+    database.execute.mockRejectedValue({ code: 'ER_ROW_IS_REFERENCED_2' });
+    const response = await request(app)
+      .delete('/api/admin/categories/9')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(409);
+    expect(response.body.message).toContain('masih digunakan');
+  });
+});
+
+describe('category and services deletion', () => {
+  it('deletes services and their category in one transaction with explicit consent', async () => {
+    connection.query.mockResolvedValueOnce([[{ id: 9 }]]);
+    const response = await request(app)
+      .delete('/api/admin/categories/9?deleteServices=true')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(200);
+    expect(connection.query).toHaveBeenCalledWith(
+      'SELECT id FROM service_categories WHERE id = ? FOR UPDATE',
+      [9],
+    );
+    expect(connection.execute).toHaveBeenNthCalledWith(
+      1,
+      'DELETE FROM services WHERE category_id = ?',
+      [9],
+    );
+    expect(connection.execute).toHaveBeenNthCalledWith(
+      2,
+      'DELETE FROM service_categories WHERE id = ?',
+      [9],
+    );
+    expect(connection.commit).toHaveBeenCalledOnce();
+    expect(connection.release).toHaveBeenCalledOnce();
+    expect(database.execute).not.toHaveBeenCalled();
+  });
+
+  it.each([1, 2])(
+    'rolls back all changes if deletion step %s fails',
+    async (step) => {
+      connection.query.mockResolvedValueOnce([[{ id: 9 }]]);
+      if (step === 2)
+        connection.execute.mockResolvedValueOnce([{ affectedRows: 2 }]);
+      connection.execute.mockRejectedValueOnce({
+        code: 'ER_ROW_IS_REFERENCED_2',
+      });
+      const response = await request(app)
+        .delete('/api/admin/categories/9?deleteServices=true')
+        .set('Authorization', `Bearer ${token()}`);
+      expect(response.status).toBe(409);
+      expect(response.body.message).toContain('tidak dihapus');
+      expect(connection.rollback).toHaveBeenCalledOnce();
+      expect(connection.commit).not.toHaveBeenCalled();
+      expect(connection.release).toHaveBeenCalledOnce();
+    },
+  );
+
+  it('does not delete any services when the category is missing', async () => {
+    connection.query.mockResolvedValueOnce([[]]);
+    const response = await request(app)
+      .delete('/api/admin/categories/9?deleteServices=true')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(404);
+    expect(connection.execute).not.toHaveBeenCalled();
+    expect(connection.rollback).toHaveBeenCalledOnce();
+  });
+
+  it('rejects invalid consent before accessing the database', async () => {
+    const response = await request(app)
+      .delete('/api/admin/categories/9?deleteServices=yes')
+      .set('Authorization', `Bearer ${token()}`);
+    expect(response.status).toBe(400);
+    expect(database.getConnection).not.toHaveBeenCalled();
+    expect(database.execute).not.toHaveBeenCalled();
+  });
+
+  it('protects bulk deletion from customer accounts', async () => {
+    const response = await request(app)
+      .delete('/api/admin/categories/9?deleteServices=true')
+      .set('Authorization', `Bearer ${token('customer')}`);
+    expect(response.status).toBe(403);
+    expect(database.getConnection).not.toHaveBeenCalled();
+  });
+});
+
+describe('services use database categories', () => {
+  it.each([
+    ['Perawatan taman', 'Perawatan taman'],
+    ['Sofa', 'Sofa dan Kasur'],
+    ['constructor', 'constructor'],
+  ])(
+    'accepts category %s and preserves legacy aliases',
+    async (category, databaseName) => {
+      connection.query
+        .mockResolvedValueOnce([[{ id: 3 }]])
+        .mockResolvedValueOnce([[{ id: 9 }]]);
+      database.query
+        .mockResolvedValueOnce([
+          [
+            {
+              id: 3,
+              name: 'Layanan',
+              category: databaseName,
+              duration: '2 jam',
+              price: 100000,
+              description: 'Layanan kebersihan',
+              active: 1,
+            },
+          ],
+        ])
+        .mockResolvedValueOnce([[]]);
+      const response = await request(app)
+        .patch('/api/services/3')
+        .set('Authorization', `Bearer ${token()}`)
+        .send({ category });
+      expect(response.status).toBe(200);
+      expect(response.body.data.category).toBe(category);
+      expect(connection.query).toHaveBeenCalledWith(
+        'SELECT id FROM service_categories WHERE name = ? LIMIT 1',
+        [databaseName],
+      );
+      expect(connection.commit).toHaveBeenCalledOnce();
+      expect(connection.release).toHaveBeenCalledOnce();
+    },
+  );
+
+  it('returns a field error and rolls back if the chosen category was deleted', async () => {
+    connection.query
+      .mockResolvedValueOnce([[{ id: 3 }]])
+      .mockResolvedValueOnce([[]]);
+    const response = await request(app)
+      .patch('/api/services/3')
+      .set('Authorization', `Bearer ${token()}`)
+      .send({ category: 'Kategori terhapus' });
+    expect(response.status).toBe(400);
+    expect(response.body.errors.category).toBe('Kategori layanan tidak valid.');
+    expect(connection.rollback).toHaveBeenCalledOnce();
+    expect(connection.commit).not.toHaveBeenCalled();
+    expect(connection.execute).not.toHaveBeenCalled();
+  });
+});
