# URL server Express milik tim backend, tanpa trailing slash
API_URL=http://127.0.0.1:3001/api

# Mode demo frontend lokal: login admin / admin, tanpa request ke API tim.
# Hanya berlaku pada npm run dev / dev:lan; selalu nonaktif di production.
ADMIN_DEMO_ENABLED=false

# Aktifkan hanya untuk uji alur cleaner. Semua pesan data [UJI] disimulasikan.
CLEANER_DEMO_ENABLED=false
# Direktori persisten opsional untuk data uji; default frontend/.local/cleaner-demo
# CLEANER_DEMO_DATA_DIR=C:/path/cleaner-demo
# URL frontend yang bisa dibuka petugas. Gunakan HTTPS pada deployment.
# APP_PUBLIC_URL=https://admin.cleango.example
